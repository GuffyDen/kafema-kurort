# Tablo platform / tenant integration.
# IIKO_APP_ID and IIKO_CLIENT_SECRET belong to the Tablo app.
# IIKO_API_KEY and IIKO_TERMINAL_GROUP_ID belong to a specific tenant.

IIKO_API_BASE_URL=https://api-ru.iiko.services/api/1/
IIKO_API_KEY=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_TERMINAL_GROUP_ID=

# Legacy / optional. iiko Cloud API v2 token does not use this value.
IIKO_API_LOGIN=

IIKO_WEBHOOK_TOKEN=your_webhook_token_here

# Public URL of the current tenant deployment.
# For the first pilot this points to Kafema Kurort.
NEXT_PUBLIC_APP_URL=https://kafema-kurort.ru

# Persistent Tablo storefront overrides.
# Use REDIS_URL (redis:// or rediss://), or an Upstash/KV REST pair.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Temporary Server Orders v1 protection for /bar order data and status updates.
# Use a collision-resistant value of at least 32 characters. Replace with
# employee authentication/roles before production rollout.
BARISTA_ACCESS_TOKEN=

# Vercel Blob stores tenant-uploaded Table Stand background images.
BLOB_READ_WRITE_TOKEN=

# Protects existing non-YooKassa scheduled maintenance endpoints.
CRON_SECRET=

# YooKassa: server-only, tenant deployment scoped. Default is disabled.
# Keep disabled. Use test only with separate TEST shop credentials in isolation.
# live is explicit; enable only after approval and isolated verification.
# Live creation also requires its own YOOKASSA_CRON_SECRET (32+ chars) and an
# external fiscal scheduler that calls /api/cron/yookassa-fiscal with a Bearer header.
YOOKASSA_MODE=disabled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CRON_SECRET=
# NEXT_PUBLIC_APP_URL above is the trusted HTTPS origin for /payment/return.
